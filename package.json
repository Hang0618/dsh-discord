{
  "name": "dsh-discord",
  "version": "0.6.14",
  "private": true,
  "description": "把 DSH 接到 Discord：零依赖 Cordis 插件，流式回复、固定会话、陌生人准入、余额预算",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "discord",
    "discord-bot",
    "bridge"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hang0618/dsh-discord.git"
  },
  "bugs": {
    "url": "https://github.com/Hang0618/dsh-discord/issues"
  },
  "homepage": "https://github.com/Hang0618/dsh-discord#readme",
  "license": "MIT"
}

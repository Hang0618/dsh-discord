{
  "name": "dsh-discord",
  "version": "0.3.9",
  "private": true,
  "description": "在 Discord 里跟 DSH 里的鲸鱼娘聊天：私聊只认主人，服务器里 @ 才接话（陌生人先经 GUI 确认），零依赖 bot 网关 + 流式回复 + 固定会话（记忆共用）",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "discord",
    "discord-bot",
    "bridge"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hang0618/dsh-discord.git"
  },
  "bugs": {
    "url": "https://github.com/Hang0618/dsh-discord/issues"
  },
  "homepage": "https://github.com/Hang0618/dsh-discord#readme",
  "license": "MIT"
}
